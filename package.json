{
  "name": "yukumo",
  "version": "1.5.0",
  "description": "High-performance, framework-agnostic Lavalink v4 client for JavaScript and TypeScript",
  "keywords": [
    "lavalink",
    "lavalink-client",
    "lavalink-v4",
    "music",
    "discord",
    "voice",
    "audio",
    "yukumo"
  ],
  "homepage": "https://yukumo.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nex-Devz/YuKumo.git"
  },
  "bugs": {
    "url": "https://github.com/Nex-Devz/YuKumo/issues"
  },
  "license": "MIT",
  "author": "Yukumo Contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "bun run src/bench.ts",
    "test:integration": "bash test/run-integration.sh",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test",
    "release": "npm run prepublishOnly && npm publish --access public",
    "release:dry": "npm run prepublishOnly && npm publish --dry-run"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  }
}